# ============================================
# Playground Series S6E8 - CatBoost + Feature Engineering
# ============================================

import pandas as pd
import numpy as np
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
from catboost import CatBoostClassifier
import warnings
warnings.filterwarnings('ignore')

# ---- 1. Load Data ----
DATA_DIR = '/kaggle/input/competitions/playground-series-s6e8'

train = pd.read_csv(f'{DATA_DIR}/train.csv')
test = pd.read_csv(f'{DATA_DIR}/test.csv')

print(f"Train shape: {train.shape}")
print(f"Test shape:  {test.shape}\n")

# ---- 2. Feature Setup ----
TARGET = 'addicted_label'
ID_COL = 'id'
CAT_COLS = ['gender', 'stress_level', 'academic_work_impact']
NUM_COLS = [c for c in train.columns if c not in CAT_COLS + [TARGET, ID_COL]]

# Ordinal encode categoricals
GENDER_MAP = {'Male': 0, 'Female': 1, 'Other': 2, 'Missing': 3}
STRESS_MAP = {'Low': 0, 'Medium': 1, 'High': 2, 'Missing': 3}
IMPACT_MAP = {'No': 0, 'Yes': 1, 'Missing': 2}

def preprocess(df: pd.DataFrame) -> pd.DataFrame:
    df = df.copy()
    df['gender'] = df['gender'].fillna('Missing').map(GENDER_MAP)
    df['stress_level'] = df['stress_level'].fillna('Missing').map(STRESS_MAP)
    df['academic_work_impact'] = df['academic_work_impact'].fillna('Missing').map(IMPACT_MAP)
    return df

def engineer_features(df: pd.DataFrame) -> pd.DataFrame:
    """Create ratio and interaction features."""
    df = df.copy()
    
    # Ratio features (handle division by zero)
    df['social_media_ratio'] = df['social_media_hours'] / (df['daily_screen_time_hours'] + 1e-8)
    df['gaming_ratio'] = df['gaming_hours'] / (df['daily_screen_time_hours'] + 1e-8)
    df['work_ratio'] = df['work_study_hours'] / (df['daily_screen_time_hours'] + 1e-8)
    df['app_efficiency'] = df['app_opens_per_day'] / (df['notifications_per_day'] + 1e-8)
    
    # Sleep deficit (deviation from 8-hour target)
    df['sleep_deficit'] = (8 - df['sleep_hours']).abs()
    
    # Weekend vs weekday ratio
    df['weekend_to_daily_ratio'] = df['weekend_screen_time'] / (df['daily_screen_time_hours'] + 1e-8)
    
    # Engagement metrics
    df['total_activity_hours'] = (df['social_media_hours'] + df['gaming_hours'] + df['work_study_hours']).fillna(0)
    df['screen_time_intensity'] = df['app_opens_per_day'] / (df['daily_screen_time_hours'] + 1e-8)
    
    # Sleep quality indicator (notifications vs sleep)
    df['notifications_to_sleep_ratio'] = df['notifications_per_day'] / (df['sleep_hours'] + 1e-8)
    
    # Fill any NaN created by feature engineering
    df = df.fillna(0)
    
    return df

train = preprocess(train)
test = preprocess(test)

# Apply feature engineering
train = engineer_features(train)
test = engineer_features(test)

FEATURES = NUM_COLS + ['stress_level', 'academic_work_impact', 'gender'] + [
    'social_media_ratio', 'gaming_ratio', 'work_ratio', 'app_efficiency', 
    'sleep_deficit', 'weekend_to_daily_ratio', 'total_activity_hours', 
    'screen_time_intensity', 'notifications_to_sleep_ratio'
]

CAT_FEATURES_IDX = [FEATURES.index('gender')]

X = train[FEATURES]
y = train[TARGET]
X_test = test[FEATURES]

print(f"Total features: {len(FEATURES)}")
print(f"New engineered features: 9")
print(f"Original features: {len(FEATURES) - 9}\n")

# ---- 3. Cross-Validated Training ----
skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
oof_preds = np.zeros(len(train))
test_preds = np.zeros(len(test))
fold_scores = []

catboost_params = {
    'iterations': 2000,
    'learning_rate': 0.05,
    'depth': 8,
    'l2_leaf_reg': 1.0,
    'subsample': 0.8,
    'colsample_bylevel': 0.8,
    'min_data_in_leaf': 30,
    'loss_function': 'Logloss',
    'eval_metric': 'AUC',
    'early_stopping_rounds': 100,
    'verbose': False,
    'random_state': 42,
    'use_best_model': True,
}

print("=" * 50)
print("TRAINING CATBOOST (WITH ENGINEERED FEATURES)")
print("=" * 50)

for fold, (train_idx, val_idx) in enumerate(skf.split(X, y), start=1):
    X_tr, X_val = X.iloc[train_idx], X.iloc[val_idx]
    y_tr, y_val = y.iloc[train_idx], y.iloc[val_idx]

    model = CatBoostClassifier(**catboost_params, cat_features=CAT_FEATURES_IDX)

    model.fit(
        X_tr, y_tr,
        eval_set=(X_val, y_val),
        verbose=False,
    )

    val_pred = model.predict_proba(X_val)[:, 1]
    oof_preds[val_idx] = val_pred
    test_preds += model.predict_proba(X_test)[:, 1] / 5

    fold_auc = roc_auc_score(y_val, val_pred)
    fold_scores.append(fold_auc)
    print(f"Fold {fold}/5 — AUC: {fold_auc:.5f}")

# ---- 4. Results ----
overall_auc = roc_auc_score(y, oof_preds)

print(f"\nFold scores:    {[f'{s:.5f}' for s in fold_scores]}")
print(f"Mean fold AUC:  {np.mean(fold_scores):.5f} (+/- {np.std(fold_scores):.5f})")
print(f"Overall OOF AUC: {overall_auc:.5f}")

# ---- 5. Feature Importance ----
print("\n" + "=" * 50)
print("TOP 15 MOST IMPORTANT FEATURES")
print("=" * 50)

importance_df = pd.DataFrame({
    'feature': FEATURES,
    'importance': model.feature_importances_
}).sort_values('importance', ascending=False)

print(importance_df.head(15))

# ---- 6. Submission ----
submission = pd.DataFrame({
    ID_COL: test[ID_COL],
    TARGET: test_preds
})

submission.to_csv('submission.csv', index=False)
print("\nsubmission.csv saved.")
print(submission.head())
