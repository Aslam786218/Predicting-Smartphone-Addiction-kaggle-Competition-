# ============================================
# Playground Series S6E8 - Stacking
# Meta-learner trained on LGB + CB OOF predictions
# ============================================

import pandas as pd
import numpy as np
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
from sklearn.linear_model import LogisticRegression
import lightgbm as lgb
from catboost import CatBoostClassifier
import warnings
warnings.filterwarnings('ignore')

# ---- 1. Load Data ----
DATA_DIR = '/kaggle/input/competitions/playground-series-s6e8'

train = pd.read_csv(f'{DATA_DIR}/train.csv')
test = pd.read_csv(f'{DATA_DIR}/test.csv')

print(f"Train shape: {train.shape}")
print(f"Test shape:  {test.shape}\n")

# ---- 2. Feature Setup ----
TARGET = 'addicted_label'
ID_COL = 'id'
CAT_COLS = ['gender', 'stress_level', 'academic_work_impact']
NUM_COLS = [c for c in train.columns if c not in CAT_COLS + [TARGET, ID_COL]]

GENDER_MAP = {'Male': 0, 'Female': 1, 'Other': 2, 'Missing': 3}
STRESS_MAP = {'Low': 0, 'Medium': 1, 'High': 2, 'Missing': 3}
IMPACT_MAP = {'No': 0, 'Yes': 1, 'Missing': 2}

def preprocess(df: pd.DataFrame) -> pd.DataFrame:
    df = df.copy()
    df['gender'] = df['gender'].fillna('Missing').map(GENDER_MAP)
    df['stress_level'] = df['stress_level'].fillna('Missing').map(STRESS_MAP)
    df['academic_work_impact'] = df['academic_work_impact'].fillna('Missing').map(IMPACT_MAP)
    return df

train = preprocess(train)
test = preprocess(test)

FEATURES = NUM_COLS + ['stress_level', 'academic_work_impact', 'gender']
CAT_FEATURES_IDX = [FEATURES.index('gender')]

X = train[FEATURES]
y = train[TARGET]
X_test = test[FEATURES]

# ---- 3. Model Parameters ----
lgb_params = {
    'objective': 'binary',
    'metric': 'auc',
    'learning_rate': 0.05,
    'num_leaves': 63,
    'min_child_samples': 30,
    'subsample': 0.8,
    'subsample_freq': 1,
    'colsample_bytree': 0.8,
    'reg_alpha': 0.1,
    'reg_lambda': 0.1,
    'random_state': 42,
    'verbosity': -1,
    'n_jobs': -1,
}

catboost_params = {
    'iterations': 2000,
    'learning_rate': 0.05,
    'depth': 8,
    'l2_leaf_reg': 1.0,
    'subsample': 0.8,
    'colsample_bylevel': 0.8,
    'min_data_in_leaf': 30,
    'loss_function': 'Logloss',
    'eval_metric': 'AUC',
    'early_stopping_rounds': 100,
    'verbose': False,
    'random_state': 42,
    'use_best_model': True,
}

# ---- 4. Layer 1: Generate OOF Predictions from Base Models ----
skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)

oof_lgbm = np.zeros(len(train))
oof_catboost = np.zeros(len(train))
test_lgbm = np.zeros(len(test))
test_catboost = np.zeros(len(test))

print("=" * 70)
print("LAYER 1: TRAINING BASE MODELS (LGB + CB)")
print("=" * 70)

for fold, (train_idx, val_idx) in enumerate(skf.split(X, y), start=1):
    X_tr, X_val = X.iloc[train_idx], X.iloc[val_idx]
    y_tr, y_val = y.iloc[train_idx], y.iloc[val_idx]

    # LightGBM
    train_set = lgb.Dataset(X_tr, label=y_tr, categorical_feature=[])
    val_set = lgb.Dataset(X_val, label=y_val, categorical_feature=[], reference=train_set)
    
    model_lgb = lgb.train(
        lgb_params, train_set, num_boost_round=2000,
        valid_sets=[val_set],
        callbacks=[lgb.early_stopping(100, verbose=False), lgb.log_evaluation(0)]
    )
    
    val_pred_lgb = model_lgb.predict(X_val, num_iteration=model_lgb.best_iteration)
    oof_lgbm[val_idx] = val_pred_lgb
    test_lgbm += model_lgb.predict(X_test, num_iteration=model_lgb.best_iteration) / 5

    # CatBoost
    model_cb = CatBoostClassifier(**catboost_params, cat_features=CAT_FEATURES_IDX)
    model_cb.fit(X_tr, y_tr, eval_set=(X_val, y_val), verbose=False)
    
    val_pred_cb = model_cb.predict_proba(X_val)[:, 1]
    oof_catboost[val_idx] = val_pred_cb
    test_catboost += model_cb.predict_proba(X_test)[:, 1] / 5

    lgb_auc = roc_auc_score(y_val, val_pred_lgb)
    cb_auc = roc_auc_score(y_val, val_pred_cb)
    print(f"Fold {fold}/5 — LGB: {lgb_auc:.5f} | CB: {cb_auc:.5f}")

# ---- 5. Layer 2: Train Meta-Learner on OOF Predictions ----
print("\n" + "=" * 70)
print("LAYER 2: TRAINING META-LEARNER (Logistic Regression)")
print("=" * 70)

# Meta-features: OOF predictions from base models
X_meta = np.column_stack([oof_lgbm, oof_catboost])
X_meta_test = np.column_stack([test_lgbm, test_catboost])

# Train meta-learner on full training data
meta_model = LogisticRegression(random_state=42, max_iter=1000)
meta_model.fit(X_meta, y)

# Get meta-learner coefficients (learned weights)
lgb_weight = meta_model.coef_[0][0]
cb_weight = meta_model.coef_[0][1]

# Normalize weights to sum to 1
total_weight = lgb_weight + cb_weight
lgb_weight_norm = lgb_weight / total_weight
cb_weight_norm = cb_weight / total_weight

print(f"\nMeta-Learner Learned Weights:")
print(f"  LightGBM: {lgb_weight_norm:.4f} ({lgb_weight_norm*100:.2f}%)")
print(f"  CatBoost: {cb_weight_norm:.4f} ({cb_weight_norm*100:.2f}%)")

# ---- 6. Final Predictions & Evaluation ----
print("\n" + "=" * 70)
print("STACKING RESULTS")
print("=" * 70)

# On training data
oof_stacked = meta_model.predict_proba(X_meta)[:, 1]
stacked_oof_auc = roc_auc_score(y, oof_stacked)

# On test data
test_stacked = meta_model.predict_proba(X_meta_test)[:, 1]

lgb_oof_auc = roc_auc_score(y, oof_lgbm)
cb_oof_auc = roc_auc_score(y, oof_catboost)

print(f"\nBase Model OOF AUC:")
print(f"  LightGBM:      {lgb_oof_auc:.5f}")
print(f"  CatBoost:      {cb_oof_auc:.5f}")

print(f"\nStacked (Meta-Learner) OOF AUC: {stacked_oof_auc:.5f}")
print(f"vs Simple 50/50 Blend (0.96524): {'✅ BETTER' if stacked_oof_auc > 0.96524 else '❌ Lower'}")

# ---- 7. Submission ----
submission = pd.DataFrame({
    ID_COL: test[ID_COL],
    TARGET: test_stacked
})

submission.to_csv('submission.csv', index=False)
print(f"\nsubmission.csv saved (Stacking with learned weights)")
print(submission.head())
