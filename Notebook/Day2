import pandas as pd
import numpy as np
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
from catboost import CatBoostClassifier
import warnings
warnings.filterwarnings('ignore')

# ---- 1. Load Data ----
DATA_DIR = '/kaggle/input/competitions/playground-series-s6e8'

train = pd.read_csv(f'{DATA_DIR}/train.csv')
test = pd.read_csv(f'{DATA_DIR}/test.csv')

print(f"Train shape: {train.shape}")
print(f"Test shape:  {test.shape}\n")

# ---- 2. Feature Setup ----
TARGET = 'addicted_label'
ID_COL = 'id'
CAT_COLS = ['gender', 'stress_level', 'academic_work_impact']
NUM_COLS = [c for c in train.columns if c not in CAT_COLS + [TARGET, ID_COL]]

# Ordinal encode stress_level (natural order)
STRESS_MAP = {'Low': 0, 'Medium': 1, 'High': 2}
IMPACT_MAP = {'No': 0, 'Yes': 1}

def preprocess(df: pd.DataFrame) -> pd.DataFrame:
    df = df.copy()
    # Fill NaN in categorical columns with 'Missing' before mapping
    df['gender'] = df['gender'].fillna('Missing')
    df['stress_level'] = df['stress_level'].fillna('Missing').map(STRESS_MAP)
    df['academic_work_impact'] = df['academic_work_impact'].fillna('Missing').map(IMPACT_MAP)
    return df

# Also update STRESS_MAP and IMPACT_MAP to handle 'Missing'
STRESS_MAP = {'Low': 0, 'Medium': 1, 'High': 2, 'Missing': 3}
IMPACT_MAP = {'No': 0, 'Yes': 1, 'Missing': 2}

train = preprocess(train)
test = preprocess(test)

FEATURES = NUM_COLS + ['stress_level', 'academic_work_impact', 'gender']
CAT_FEATURES_IDX = [FEATURES.index(c) for c in ['gender']]  # Only gender stays categorical in CatBoost

X = train[FEATURES]
y = train[TARGET]
X_test = test[FEATURES]

# ---- 3. Model Configuration ----
CATBOOST_PARAMS = {
    'iterations': 2000,
    'learning_rate': 0.05,
    'depth': 8,
    'l2_leaf_reg': 1.0,
    'subsample': 0.8,
    'colsample_bylevel': 0.8,
    'min_data_in_leaf': 30,
    'loss_function': 'Logloss',
    'eval_metric': 'AUC',
    'early_stopping_rounds': 100,
    'verbose': False,
    'random_state': 42,
    'use_best_model': True,
}

# ---- 4. Cross-Validated Training ----
skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
oof_preds = np.zeros(len(train))
test_preds = np.zeros(len(test))
fold_scores = []

for fold, (train_idx, val_idx) in enumerate(skf.split(X, y), start=1):
    X_tr, X_val = X.iloc[train_idx], X.iloc[val_idx]
    y_tr, y_val = y.iloc[train_idx], y.iloc[val_idx]

    model = CatBoostClassifier(
        **CATBOOST_PARAMS,
        cat_features=CAT_FEATURES_IDX,
    )

    model.fit(
        X_tr, y_tr,
        eval_set=(X_val, y_val),
        verbose=False,
    )

    val_pred = model.predict_proba(X_val)[:, 1]
    oof_preds[val_idx] = val_pred

    fold_auc = roc_auc_score(y_val, val_pred)
    fold_scores.append(fold_auc)
    print(f"Fold {fold}/5 — AUC: {fold_auc:.5f}")

    test_preds += model.predict_proba(X_test)[:, 1] / 5

# ---- 5. Results ----
overall_auc = roc_auc_score(y, oof_preds)

print(f"\nFold scores:    {[f'{s:.5f}' for s in fold_scores]}")
print(f"Mean fold AUC:  {np.mean(fold_scores):.5f} (+/- {np.std(fold_scores):.5f})")
print(f"Overall OOF AUC: {overall_auc:.5f}")

# ---- 6. Feature Importance ----
importance_df = pd.DataFrame({
    'feature': FEATURES,
    'importance': model.feature_importances_
}).sort_values('importance', ascending=False)

print(f"\nTop 10 features:\n{importance_df.head(10)}")

# ---- 7. Submission ----
submission = pd.DataFrame({
    ID_COL: test[ID_COL],
    TARGET: test_preds
})

submission.to_csv('submission.csv', index=False)
print("\nsubmission.csv saved.")
print(submission.head())
